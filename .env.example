# 复制为 .env.local 后只在本机填写；不要提交真实密钥。
# 文字：codex（默认）或 deepseek。codex 需要兼容 CLI 和自己的登录。
NPC_TEXT_PROVIDER=codex
# NPC_CODEX_BIN 等高级路径应在启动前 export；详见 LOCAL-DEPENDENCIES.md。

# 可选 DeepSeek 文字后端：改 NPC_TEXT_PROVIDER=deepseek 后填写。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 语音消息：openai、doubao、local、qwen 或 qwen-local。
# 空密钥不会提供在线语音；local/qwen/qwen-local 的识别还需另装本地 ASR。
NPC_AUDIO_PROVIDER=openai

# openai 语音消息（只有选择 openai 时需要）
NPC_AUDIO_API_KEY=
NPC_ASR_MODEL=gpt-4o-mini-transcribe
NPC_TTS_MODEL=gpt-4o-mini-tts
# NPC_VOICE_XIA_XIA=coral
# NPC_VOICE_YUAN=nova
# NPC_VOICE_MOLLY=alloy
# NPC_VOICE_LIU=alloy

# doubao 录音消息（独立于应用内实时通话配置）
# DOUBAO_SPEECH_API_KEY=
# DOUBAO_ASR_RESOURCE_ID=volc.bigasr.auc_turbo
# DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
# DOUBAO_DEFAULT_VOICE=zh_female_vv_uranus_bigtts

# qwen 在线合成：需自己的北京地域工作空间和密钥
# DASHSCOPE_API_KEY=
# DASHSCOPE_WORKSPACE_ID=
# QWEN_TTS_MODEL=qwen-audio-3.0-tts-flash

# qwen-local：另行安装 Python 环境和模型；路径相对于仓库根目录
# QWEN_TTS_LOCAL_PYTHON=.npc-runtime/qwen3-tts-env/bin/python
# QWEN_TTS_LOCAL_MODEL=.npc-runtime/models/Qwen3-TTS-12Hz-0.6B-CustomVoice
# QWEN_TTS_LOCAL_URL=http://127.0.0.1:9873
# QWEN_LOCAL_SPEAKER_XIA_XIA=Vivian
# QWEN_LOCAL_SPEAKER_YUAN=Serena
# QWEN_LOCAL_SPEAKER_MOLLY=Vivian
# QWEN_LOCAL_SPEAKER_LIU=Vivian

# 实时通话密钥通过应用内设置写入忽略的 .npc-runtime/，不在此导出。
